{
  "name": "@focuslog/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages/shared/src --import ./scripts/register-swc.ts src/main.ts",
    "start": "node --import ./scripts/register-swc.ts src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@focuslog/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "^1.7.15",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "nestjs-zod": "5.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  }
}
